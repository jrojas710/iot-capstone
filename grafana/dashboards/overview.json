{
 "uid": "capstone-overview",
 "title": "IoT Capstone — Visión general",
 "timezone": "America/Bogota",
 "time": {
  "from": "now-6d",
  "to": "now"
 },
 "refresh": "1m",
 "schemaVersion": 39,
 "editable": true,
 "tags": [
  "capstone"
 ],
 "links": [
  {
   "title": "Detalle por dispositivo",
   "type": "link",
   "url": "/grafana/d/capstone-dispositivo"
  },
  {
   "title": "Panel de control (retroceso)",
   "type": "link",
   "url": "/"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Dispositivos reportando (últimos 20 min)",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx"
     },
     "query": "from(bucket: \"iot\")\n  |> range(start: -20m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\")\n  |> group(columns: [\"device\"])\n  |> last()\n  |> group()\n  |> count()\n  |> map(fn: (r) => ({_time: now(), _value: r._value, _field: \"dispositivos\"}))"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "colorMode": "background"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "table",
   "title": "Estado actual de los dispositivos (retroceso)",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "gridPos": {
    "h": 11,
    "w": 16,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx"
     },
     "query": "from(bucket: \"iot\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"device_state\" and (r._field == \"power\" or r._field == \"period_s\"))\n  |> last()\n  |> pivot(rowKey: [\"device\", \"kind\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"kind\", \"device\", \"power\", \"period_s\", \"_time\"])\n  |> sort(columns: [\"kind\", \"device\"])"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "power"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "apagado",
            "color": "red"
           },
           "1": {
            "text": "encendido",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "kind": "Tipo",
       "device": "Dispositivo",
       "power": "Estado",
       "period_s": "Periodo (s)",
       "_time": "Último cambio"
      }
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "table",
   "title": "Alertas registradas",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx"
     },
     "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alerts\" and r._field == \"firing\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> keep(columns: [\"_time\", \"alertname\", \"device\", \"_value\"])"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "_value"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "activa",
            "color": "red"
           },
           "0": {
            "text": "resuelta",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "displayName",
        "value": "Estado"
       }
      ]
     }
    ]
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Temperatura — todas las fuentes (°C)",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 11
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx"
     },
     "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and (r._field == \"temperature_c\" or r._field == \"air_temp_c\" or r._field == \"room_temp_c\" or r._field == \"cpu_temp_c\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: r.device + \" · \" + r._field}))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "spanNulls": 3600000
     },
     "unit": "celsius"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "min"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
